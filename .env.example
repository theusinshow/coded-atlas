ATLAS_OUTPUT_DIR=
ATLAS_HEADLESS=true
ATLAS_NAV_TIMEOUT_MS=30000
ATLAS_CAPTURE_DELAY_MS=3000

# Atlas Brain (IA) — opcional. Sem chave, os planos usam as regras determinísticas do Atlas.
OPENAI_API_KEY=
ATLAS_AI_MODEL=gpt-6-luna
# Preços em USD por 1 milhão de tokens (sem eles o custo aparece como "não configurado")
ATLAS_AI_PRICE_INPUT=
ATLAS_AI_PRICE_CACHED_INPUT=
ATLAS_AI_PRICE_OUTPUT=
# Orçamento mensal: warn só avisa, block volta para as regras do Atlas ao estourar
ATLAS_AI_BUDGET_USD=
ATLAS_AI_BUDGET_MODE=warn
# Miniaturas enviadas ao modelo por plano (0 = só texto)
ATLAS_AI_IMAGES=6

# Entregas (Publicar / Portfólio) — sempre disparadas por um clique
# Pasta local das entregas (padrão: <ATLAS_HOME>/exports)
ATLAS_EXPORT_DIR=
# Repositório do portfólio no GitHub — opcional (token com permissão de escrita no conteúdo)
ATLAS_GITHUB_TOKEN=
ATLAS_GITHUB_REPO=
ATLAS_GITHUB_BRANCH=main
ATLAS_GITHUB_PATH=atlas
# Binário do FFmpeg (vídeo), se não estiver no PATH
ATLAS_FFMPEG=
